<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://neo.com/workflow">

    <!--
      Claim lifecycle: creation -> supplier negotiations -> manager approval ->
      finance approval for high values -> implementation. businessKey = claim lineId.
      Service tasks only emit domain events / update workflow state; the JPA
      domain layer owns all business writes via #{domainEvents.*}.
    -->
    <process id="claimLifecycle" name="Claim Lifecycle" isExecutable="true">

        <startEvent id="start" name="Claim submitted"/>

        <serviceTask id="recordSubmission"
                     name="Record submission"
                     flowable:expression="#{domainEvents.handle(execution, 'SUBMITTED')}"/>

        <exclusiveGateway id="hasDocumentsGateway" name="Documents attached?" default="flow-no-documents"/>

        <serviceTask id="notifyManager"
                     name="Notify manager"
                     flowable:expression="#{domainEvents.handle(execution, 'MANAGER_APPROVAL_REQUESTED')}"/>

        <userTask id="managerApproval"
                  name="Manager approval"
                  flowable:candidateGroups="${supervisorGroup}"
                  flowable:formKey="managerApproval"
                  flowable:dueDate="${managerReminderDuration}"/>

        <boundaryEvent id="managerReminderTimer" name="Reminder" attachedToRef="managerApproval" cancelActivity="false">
            <timerEventDefinition>
                <timeDuration>${managerReminderDuration}</timeDuration>
            </timerEventDefinition>
        </boundaryEvent>

        <serviceTask id="remindManager"
                     name="Send reminder"
                     flowable:expression="#{domainEvents.handle(execution, 'MANAGER_REMINDER')}"/>

        <boundaryEvent id="managerEscalationTimer" name="Escalation" attachedToRef="managerApproval" cancelActivity="true">
            <timerEventDefinition>
                <timeDuration>${managerEscalationDuration}</timeDuration>
            </timerEventDefinition>
        </boundaryEvent>

        <serviceTask id="escalateManager"
                     name="Escalate to management"
                     flowable:expression="#{domainEvents.handle(execution, 'MANAGER_ESCALATION')}"/>

        <exclusiveGateway id="managerDecisionGateway" name="Manager decision" default="flow-manager-not-approved"/>

        <serviceTask id="evaluatePolicy"
                     name="Evaluate finance policy"
                     flowable:expression="#{domainEvents.evaluatePolicy(execution)}"/>

        <exclusiveGateway id="financeGateway" name="Finance approval required?" default="flow-no-finance"/>

        <serviceTask id="notifyFinance"
                     name="Notify finance"
                     flowable:expression="#{domainEvents.handle(execution, 'FINANCE_APPROVAL_REQUESTED')}"/>

        <userTask id="financeApproval"
                  name="Finance approval"
                  flowable:candidateGroups="${financeGroup}"
                  flowable:formKey="financeApproval"/>

        <serviceTask id="finalizeRequest"
                     name="Finalize claim"
                     flowable:expression="#{domainEvents.finalizeRequest(execution)}"/>

        <exclusiveGateway id="outcomeGateway" name="Outcome" default="flow-outcome-rejected"/>

        <serviceTask id="confirmBooking"
                     name="Confirm implementation"
                     flowable:expression="#{domainEvents.confirmBooking(execution)}"/>

        <serviceTask id="notifyOutcome"
                     name="Notify approval"
                     flowable:expression="#{domainEvents.handle(execution, 'FINAL_OUTCOME')}"/>

        <serviceTask id="notifyRejected"
                     name="Notify rejection"
                     flowable:expression="#{domainEvents.handle(execution, 'FINAL_OUTCOME')}"/>

        <endEvent id="completed" name="Approved"/>

        <endEvent id="rejected" name="Rejected"/>

        <endEvent id="reminderSent" name="Reminder sent"/>

        <sequenceFlow id="flow-start" sourceRef="start" targetRef="recordSubmission"/>
        <sequenceFlow id="flow-recorded" sourceRef="recordSubmission" targetRef="hasDocumentsGateway"/>
        <sequenceFlow id="flow-has-documents" sourceRef="hasDocumentsGateway" targetRef="notifyManager">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${execution.getVariable('hasDocuments') == true}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow-no-documents" sourceRef="hasDocumentsGateway" targetRef="notifyManager"/>
        <sequenceFlow id="flow-notified-manager" sourceRef="notifyManager" targetRef="managerApproval"/>
        <sequenceFlow id="flow-manager-decided" sourceRef="managerApproval" targetRef="managerDecisionGateway"/>
        <sequenceFlow id="flow-manager-approved" sourceRef="managerDecisionGateway" targetRef="evaluatePolicy">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${execution.getVariable('approved') == true}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow-manager-not-approved" sourceRef="managerDecisionGateway" targetRef="finalizeRequest"/>
        <sequenceFlow id="flow-policy-evaluated" sourceRef="evaluatePolicy" targetRef="financeGateway"/>
        <sequenceFlow id="flow-needs-finance" sourceRef="financeGateway" targetRef="notifyFinance">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${execution.getVariable('requiresFinance') == true}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow-no-finance" sourceRef="financeGateway" targetRef="finalizeRequest"/>
        <sequenceFlow id="flow-finance-notified" sourceRef="notifyFinance" targetRef="financeApproval"/>
        <sequenceFlow id="flow-finance-decided" sourceRef="financeApproval" targetRef="finalizeRequest"/>
        <sequenceFlow id="flow-finalized" sourceRef="finalizeRequest" targetRef="outcomeGateway"/>
        <sequenceFlow id="flow-outcome-approved" sourceRef="outcomeGateway" targetRef="confirmBooking">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${execution.getVariable('approved') == true}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow id="flow-booking-confirmed" sourceRef="confirmBooking" targetRef="notifyOutcome"/>
        <sequenceFlow id="flow-outcome-rejected" sourceRef="outcomeGateway" targetRef="notifyRejected"/>
        <sequenceFlow id="flow-approved-end" sourceRef="notifyOutcome" targetRef="completed"/>
        <sequenceFlow id="flow-rejected-end" sourceRef="notifyRejected" targetRef="rejected"/>

        <sequenceFlow id="flow-reminder" sourceRef="managerReminderTimer" targetRef="remindManager"/>
        <sequenceFlow id="flow-reminder-end" sourceRef="remindManager" targetRef="reminderSent"/>
        <sequenceFlow id="flow-escalation" sourceRef="managerEscalationTimer" targetRef="escalateManager"/>
        <sequenceFlow id="flow-escalated" sourceRef="escalateManager" targetRef="finalizeRequest"/>
    </process>
</definitions>
